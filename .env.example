# Copie para .env e ajuste se necessario. Valores abaixo sao apenas defaults de dev,
# nunca use estas senhas em um ambiente real.

# Superusuario do container Postgres (usado so para bootstrap dos roles no init script)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=estokio

# Porta do host mapeada para o Postgres do projeto.
# 5432 ja esta ocupada por um Postgres nativo do sistema nesta maquina, por isso 5433.
ESTOKIO_DB_PORT=5433

# Papeis de aplicacao (ver infra/postgres/init/01-create-roles.sh)
ESTOKIO_MIGRATOR_PASSWORD=migrator_dev_only
ESTOKIO_APP_USER_PASSWORD=app_user_dev_only
ESTOKIO_APP_PLATFORM_PASSWORD=app_platform_dev_only

# JWT
ESTOKIO_JWT_SECRET=dev-only-secret-troque-em-producao-32-bytes-minimo!!
ESTOKIO_JWT_ACCESS_TTL_MINUTES=15
ESTOKIO_JWT_REFRESH_TTL_DAYS=7
